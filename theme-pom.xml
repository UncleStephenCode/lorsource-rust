<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>ru.org.linux</groupId>
  <artifactId>lorsource-rust-themes</artifactId>
  <version>1</version>
  <properties>
    <swiffy-slider.version>1.6.0</swiffy-slider.version>
    <tippy.version>6.3.7</tippy.version>
  </properties>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.11.0</version>
        <executions>
          <execution>
            <id>unpack-theme-css</id>
            <phase>generate-sources</phase>
            <goals><goal>unpack</goal></goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>org.webjars.npm</groupId>
                  <artifactId>swiffy-slider</artifactId>
                  <version>${swiffy-slider.version}</version>
                  <includes>**/swiffy-slider.min.css</includes>
                </artifactItem>
                <artifactItem>
                  <groupId>org.webjars.npm</groupId>
                  <artifactId>tippy.js</artifactId>
                  <version>${tippy.version}</version>
                  <includes>**/tippy.css</includes>
                </artifactItem>
              </artifactItems>
              <outputDirectory>${project.basedir}/target/theme-deps</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>io.github.cleydyr</groupId>
        <artifactId>dart-sass-maven-plugin</artifactId>
        <version>1.5.0</version>
        <executions>
          <execution>
            <phase>generate-resources</phase>
            <goals><goal>compile-sass</goal></goals>
          </execution>
        </executions>
        <configuration>
          <inputFolder>${project.basedir}/frontend/sass</inputFolder>
          <outputFolder>${project.basedir}/static</outputFolder>
          <style>COMPRESSED</style>
          <version>1.99.0</version>
          <noCharset>true</noCharset>
          <noSourceMap>true</noSourceMap>
          <cachedFilesDirectory>${project.basedir}/target/dart-sass-cache</cachedFilesDirectory>
        </configuration>
      </plugin>
      <plugin>
        <groupId>net.alchim31.maven</groupId>
        <artifactId>yuicompressor-maven-plugin</artifactId>
        <version>1.5.1</version>
        <executions>
          <execution>
            <phase>compile</phase>
            <goals><goal>compress</goal></goals>
          </execution>
        </executions>
        <configuration>
          <nosuffix>true</nosuffix>
          <jswarn>false</jswarn>
          <encoding>utf-8</encoding>
          <excludes><exclude>**/*.js</exclude></excludes>
          <aggregations>
            <aggregation>
              <removeIncluded>false</removeIncluded><insertNewLine>true</insertNewLine>
              <output>${project.basedir}/static/tango/combined.css</output>
              <includes>
                <include>${project.basedir}/target/theme-deps/META-INF/resources/webjars/swiffy-slider/${swiffy-slider.version}/dist/css/swiffy-slider.min.css</include>
                <include>${project.basedir}/target/theme-deps/META-INF/resources/webjars/tippy.js/${tippy.version}/dist/tippy.css</include>
                <include>${project.basedir}/static/tango/auto.css</include>
                <include>${project.basedir}/static/tango/syntax.css</include>
              </includes>
            </aggregation>
            <aggregation>
              <removeIncluded>false</removeIncluded><insertNewLine>true</insertNewLine>
              <output>${project.basedir}/static/zomg_ponies/combined.css</output>
              <includes>
                <include>${project.basedir}/target/theme-deps/META-INF/resources/webjars/swiffy-slider/${swiffy-slider.version}/dist/css/swiffy-slider.min.css</include>
                <include>${project.basedir}/target/theme-deps/META-INF/resources/webjars/tippy.js/${tippy.version}/dist/tippy.css</include>
                <include>${project.basedir}/static/zomg_ponies/main.css</include>
                <include>${project.basedir}/static/tango/syntax.css</include>
              </includes>
            </aggregation>
            <aggregation>
              <removeIncluded>false</removeIncluded><insertNewLine>true</insertNewLine>
              <output>${project.basedir}/static/waltz/combined.css</output>
              <includes>
                <include>${project.basedir}/target/theme-deps/META-INF/resources/webjars/swiffy-slider/${swiffy-slider.version}/dist/css/swiffy-slider.min.css</include>
                <include>${project.basedir}/target/theme-deps/META-INF/resources/webjars/tippy.js/${tippy.version}/dist/tippy.css</include>
                <include>${project.basedir}/static/waltz/main.css</include>
                <include>${project.basedir}/static/waltz/syntax.css</include>
              </includes>
            </aggregation>
            <aggregation>
              <removeIncluded>false</removeIncluded><insertNewLine>true</insertNewLine>
              <output>${project.basedir}/static/black/combined.css</output>
              <includes>
                <include>${project.basedir}/target/theme-deps/META-INF/resources/webjars/swiffy-slider/${swiffy-slider.version}/dist/css/swiffy-slider.min.css</include>
                <include>${project.basedir}/target/theme-deps/META-INF/resources/webjars/tippy.js/${tippy.version}/dist/tippy.css</include>
                <include>${project.basedir}/static/black/main.css</include>
                <include>${project.basedir}/static/black/ir_black.css</include>
              </includes>
            </aggregation>
            <aggregation>
              <removeIncluded>false</removeIncluded><insertNewLine>true</insertNewLine>
              <output>${project.basedir}/static/white2/combined.css</output>
              <includes>
                <include>${project.basedir}/target/theme-deps/META-INF/resources/webjars/swiffy-slider/${swiffy-slider.version}/dist/css/swiffy-slider.min.css</include>
                <include>${project.basedir}/target/theme-deps/META-INF/resources/webjars/tippy.js/${tippy.version}/dist/tippy.css</include>
                <include>${project.basedir}/static/white2/main.css</include>
                <include>${project.basedir}/static/white2/idea.css</include>
              </includes>
            </aggregation>
          </aggregations>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
