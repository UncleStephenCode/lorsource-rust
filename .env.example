DATABASE_URL=postgres://linuxweb:linuxweb@localhost:5432/lor
# Production may omit DATABASE_URL and set DATABASE_URL_FILE to a mounted
# one-line secret instead. The process rejects setting both forms.
LOR_ENV=development
PUBLIC_URL=http://localhost:8181
WS_URL=ws://localhost:8181/
SITE_SECRET=change-me-in-production-change-me-in-production
# SITE_SECRET_FILE is supported for a production one-line secret mount.
LOR_HOST=0.0.0.0
LOR_PORT=8181
STATIC_DIR=static
UPLOAD_DIR=uploads
PAGE_SIZE=30
RUST_LOG=lorsource_rust=debug,tower_http=info,sqlx=warn
OPENSEARCH_URL=http://localhost:9200
# Required in production. Development may leave these unset until a flow
# actually requires CAPTCHA after a failed login or for anonymous posting.
CAPTCHA_PUBLIC_KEY=
CAPTCHA_PRIVATE_KEY=
# CAPTCHA_PRIVATE_KEY_FILE may replace CAPTCHA_PRIVATE_KEY.
CAPTCHA_VERIFY_URL=https://hcaptcha.com/siteverify
# Comma-separated CIDRs allowed to set X-Forwarded-For / X-Forwarded-Proto.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# The original Java application submits mail to an unauthenticated local MTA.
# Set SMTP_HOST to the MTA address visible from the Rust process/container.
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_HELO_NAME=localhost
# Recipient for asynchronous internal-error reports. Required in production.
ADMIN_EMAIL=
# Optional Java-compatible Best of LOR publisher. Empty/false disables it.
TELEGRAM_TOKEN=false
# TELEGRAM_TOKEN_FILE may replace TELEGRAM_TOKEN when publishing is enabled.
# Optional full URL for the Java-compatible Telegram retry path, e.g.
# http://proxy.internal:3128.
FALLBACK_PROXY_URL=
# Spring-compatible cron uses the container system timezone. Local Compose
# defaults this external setting to UTC; production requires an explicit IANA
# zone matching the original Java scheduler/JVM.
SCHEDULER_TIMEZONE=UTC
# Opt in only on the active scheduler replica. Keep false for ordinary local
# work, one-off tools and a passive dual-runtime migration replica. The durable
# OpenSearch spool worker runs independently of this flag.
# Exact lowercase true/false; enable on exactly one active scheduler replica.
ENABLE_BACKGROUND_JOBS=false
# Java defaults this to dry-run; enable physical deletion only after reviewing
# OldUserpicCleaner candidates in the logs.
CLEAN_OLD_USERPICS=false

# Administrative bootstrap/validation connections. These development defaults
# are consumed only by compat/java-db/manage.sh, never by the Rust application.
PG_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres
PG_TARGET_ADMIN_URL=postgres://postgres:postgres@localhost:5432/lor
JAVA_DATABASE_MIGRATION_URL=postgres://maxcom:maxcom@localhost:5432/lor
JAVA_DATABASE_JDBC_URL=jdbc:postgresql://localhost:5432/lor
JAVA_DATABASE_MIGRATION_USER=maxcom
JAVA_DATABASE_MIGRATION_PASSWORD=maxcom
JAVA_DATABASE_RUNTIME_URL=postgres://linuxweb:linuxweb@localhost:5432/lor
